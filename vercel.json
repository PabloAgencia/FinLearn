{
  "crons": [
    {
      "path": "/api/push-streak-reminder",
      "schedule": "0 20 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/(app-data|app-state|app-supabase|app-ui|app-game|app-tools|app-extras)\\.js(\\?.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/(app|app-extra)\\.css(\\?.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
